            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCandidato}}\",\n  \"password\": \"{{passwordPrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve un token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "const claims = JSON.parse(atob(pm.response.json().token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "pm.test(\"El token trae el rol CANDIDATO\", () => pm.expect(claims.rol).to.eql(\"CANDIDATO\"));"
                ]
              }
            }
          ]
        },
