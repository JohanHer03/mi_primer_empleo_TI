{
  "info": {
    "_postman_id": "474436b4-0d03-5eec-9c73-8fb3dd93a471",
    "name": "Primer Empleo TI",
    "description": "API de la plataforma de primer empleo TI (Medellín). Contrato: docs/contrato-api.md.\nEjecutar en orden con el Collection Runner: cada registro crea cuentas nuevas @example.com.\nEl login guarda el token en la variable {{token}}, que heredan las peticiones protegidas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar candidato (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro/candidato",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro",
                "candidato"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCandidato}}\",\n  \"password\": \"{{passwordPrueba}}\",\n  \"nombres\": \"Laura\",\n  \"apellidos\": \"Gómez Restrepo\",\n  \"estadoAcademico\": \"ESTUDIANTE\",\n  \"semestre\": 9,\n  \"universidad\": \"Universidad de Antioquia\",\n  \"programa\": \"Ingeniería de Sistemas\",\n  \"ciudad\": \"Medellín\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo único en cada ejecución para no chocar con cuentas anteriores",
                  "pm.collectionVariables.set(\"emailCandidato\", `postman.candidato.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve un token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
