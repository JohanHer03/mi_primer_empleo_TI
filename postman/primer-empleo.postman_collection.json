        {
          "name": "Registrar empresa (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro/empresa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro",
                "empresa"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailEmpresa}}\",\n  \"password\": \"{{passwordPrueba}}\",\n  \"razonSocial\": \"Software Medellín S.A.S.\",\n  \"nit\": \"{{nitEmpresa}}\",\n  \"sector\": \"Desarrollo de software\",\n  \"ciudad\": \"Medellín\",\n  \"sitioWeb\": \"https://softwaremedellin.co\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sello = Date.now().toString();",
                  "pm.collectionVariables.set(\"emailEmpresa\", `postman.empresa.${sello}@example.com`);",
                  "// NIT de 10 dígitos distinto en cada ejecución, escrito con puntos y guion: el backend los quita",
                  "const nit = \"8\" + sello.slice(-9);",
                  "pm.collectionVariables.set(\"nitEmpresa\", `${nit.slice(0, 3)}.${nit.slice(3, 6)}.${nit.slice(6, 9)}-${nit.slice(9)}`);",
                  "pm.collectionVariables.set(\"nitEmpresaDigitos\", nit);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve un token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
