# Backend Spring Boot para Vercel (contenedor como Vercel Function)
# Etapa 1: compilar el .jar con Maven
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Descargar dependencias primero para aprovechar la caché de capas
COPY pom.xml .
RUN mvn -q -B dependency:go-offline

COPY src ./src
RUN mvn -q -B package -DskipTests

# Etapa 2: imagen liviana solo con el JRE
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S app && adduser -S app -G app
COPY --from=build /app/target/*.jar app.jar
USER app

# Vercel enruta al puerto 80 por defecto; Spring lo lee desde PORT (server.port=${PORT:8080})
ENV PORT=80
# Opciones para arrancar más rápido y con poca memoria (importante por el arranque en frío)
ENV JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxRAMPercentage=75"

CMD ["java", "-jar", "app.jar"]
