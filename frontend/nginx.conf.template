server {
    # PORT lo define Vercel (80 por defecto); la imagen de nginx lo reemplaza al arrancar
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Archivos con hash de Vite: caché larga
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta de React Router devuelve index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
