# Frontend React + Vite servido con nginx (contenedor como Vercel Function)
# Etapa 1: compilar
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Vacío en Vercel: front y back comparten dominio y /api/* va al backend.
# En local (docker-compose) se pasa http://localhost:8080
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Etapa 2: servir archivos estáticos
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# nginx escucha en el puerto 80, el que Vercel usa por defecto
CMD ["nginx", "-g", "daemon off;"]
