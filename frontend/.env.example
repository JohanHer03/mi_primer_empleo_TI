# Copiar como .env.local (nunca subirlo al repositorio)
# Origen del backend sin /api. Vacío en Vercel (mismo dominio); en local, la API de Spring Boot.
VITE_API_URL=http://localhost:8080

# true: usa las respuestas simuladas de src/api/mocks mientras el backend no tenga el endpoint.
VITE_USAR_MOCKS=true
