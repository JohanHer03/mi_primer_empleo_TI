# Copiar como .env (nunca subir .env al repositorio)
# Supabase > Project Settings > Database > Connection string > Session pooler (formato JDBC)
DB_URL=jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
DB_USER=postgres.<id-del-proyecto>
DB_PASSWORD=<contraseña-de-la-base>

# Cadena aleatoria de al menos 32 bytes, por ejemplo: openssl rand -base64 48
JWT_SECRET=<secreto-largo>

CORS_ORIGINS=http://localhost:5173
